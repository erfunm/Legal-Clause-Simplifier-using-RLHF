# syntax=docker/dockerfile:1
# GPU image for `lcs serve` with vLLM (falls back to transformers if vLLM cannot load the model).
#   docker build -f docker/Dockerfile.gpu -t legal-simplifier:gpu .  (or: make docker-build-gpu)
#   docker run --gpus all ...                                        (needs the NVIDIA container toolkit)
# vLLM 0.31.0 pins torch 2.13 and transformers <5.18, so this image installs the package's
# inference extras only (no training stack) and lets vLLM choose torch (docs/decisions.md, ADR-028).
# torch's PyPI wheels bundle the CUDA runtime, so a plain Ubuntu base is enough.

FROM ubuntu:24.04 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH PIP_NO_CACHE_DIR=1
RUN pip install vllm==0.31.0
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
# [serve,otel] only: torch and transformers are the ones vLLM installed above.
RUN pip install ".[serve,otel]"

FROM ubuntu:24.04 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 app
COPY --from=builder /opt/venv /opt/venv
WORKDIR /app
COPY configs ./configs
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/home/app/.cache/huggingface \
    HF_HUB_DISABLE_TELEMETRY=1
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=300s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"
CMD ["lcs", "serve", "--config", "configs/serve.yaml", "--host", "0.0.0.0", "--port", "8000"]
